<component>
	<!-- Smart Home: a wide tile's brightness (BL-045), a thick bar ("level") dragged with the
	     finger. The fill is the level, its end a short bar; it moves only under the finger. -->
	<api>
		<prop name="value" type="int" default="80" help="Level, 0..100" />
	</api>

	<styles>
		<style name="style_device_level" radius="#radius_full" bg_color="#color_raised" bg_opa="100%" />
		<style name="style_device_level_fill" radius="#radius_full" bg_color="#color_blue" bg_opa="30%" />
		<style name="style_device_level_edge" radius="2" bg_color="#color_text" bg_opa="100%" pad_left="-22" pad_right="-22" pad_top="-12" pad_bottom="-12" />
	</styles>

	<view extends="box" width="100%" height="48">
		<lv_slider name="level" width="100%" height="100%" min_value="0" max_value="100" value="$value">
			<style name="style_device_level" />
			<style name="style_device_level_fill" selector="indicator" />
			<style name="style_device_level_edge" selector="knob" />
		</lv_slider>
		<lv_label align="left_mid" x="#space_lg" text="&#xE178;" style_text_font="icons_20" style_text_color="#color_text_2" />
	</view>
</component>
