<component>
	<!-- Smart Home: a thermostat's set point in its detail sheet (BL-045): large, between a big
	     minus and a big plus ("minus", "what_label", "value_label", "plus"). ui_devices.c fills the
	     words and tints the value in the state's colour. -->
	<api>
		<prop name="label" type="string" default="Heat to" help="What the set point does" />
		<prop name="value" type="string" default="72°" help="The set point" />
	</api>

	<styles>
		<style name="style_device_step_big" width="64" height="64" radius="#radius_full" bg_color="#color_raised" bg_opa="100%" text_color="#color_text" />
		<style name="style_device_step_big_pressed" bg_color="#color_pressed" />
	</styles>

	<view extends="box" width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_lg">
		<box name="minus" clickable="true" ext_click_area="8">
			<style name="style_device_step_big" />
			<style name="style_device_step_big_pressed" selector="pressed" />
			<lv_label align="center" text="&#xE11C;" style_text_font="icons_28" />
		</box>
		<box flex_grow="1" height="content" style_layout="flex" style_flex_flow="column" style_flex_cross_place="center" style_flex_track_place="center">
			<lv_label name="what_label" text="$label" style_text_color="#color_text_2" />
			<lv_label name="value_label" text="$value" style_text_font="font_headline" />
		</box>
		<box name="plus" clickable="true" ext_click_area="8">
			<style name="style_device_step_big" />
			<style name="style_device_step_big_pressed" selector="pressed" />
			<lv_label align="center" text="&#xE13D;" style_text_font="icons_28" />
		</box>
	</view>
</component>
