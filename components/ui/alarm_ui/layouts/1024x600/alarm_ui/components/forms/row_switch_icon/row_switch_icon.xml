<component>
	<!-- row_switch with an icon chip, for a switch among rows that have one (rule 8: a group lines
	     up). Same padding as list_row, so the words start at the same place. ui_forms.c
	     (ui_row_toggle_icon) reads the switch ("toggle") like row_switch's. -->
	<api>
		<prop name="glyph" type="string" default="&#xE19F;" help="Lucide glyph in the chip" />
		<prop name="color" type="color" default="#color_blue" help="Chip tone" />
		<prop name="title" type="string" default="Browser sign-in" help="Setting" />
		<prop name="detail" type="string" default="User name: Pat" help="What it does" />
	</api>

	<styles>
		<style name="style_row_setting_icon" width="100%" height="content" min_height="72" bg_color="#color_surface" bg_opa="100%" radius="#radius_md" pad_left="#space_md" pad_right="#space_lg" pad_top="#space_sm" pad_bottom="#space_sm" layout="flex" flex_flow="row" flex_cross_place="center" flex_track_place="center" pad_column="#space_md" />
		<style name="style_switch_icon" width="64" height="36" radius="#radius_full" bg_color="#color_pressed" bg_opa="100%" />
		<style name="style_switch_icon_indicator" radius="#radius_full" bg_opa="0%" />
		<style name="style_switch_icon_on" bg_color="#color_green" bg_opa="100%" />
		<style name="style_switch_icon_knob" radius="#radius_full" bg_color="#color_knob" bg_opa="100%" pad_all="-4" />
		<style name="style_switch_icon_knob_on" help="Empty: the high-contrast themes give it color_on_tone (themes.xml)" />
	</styles>

	<view extends="box">
		<style name="style_row_setting_icon" />
		<icon_chip name="chip" glyph="$glyph" size="44" font="icons_20" color="$color" />
		<box flex_grow="1" height="content" style_min_height="56" style_layout="flex" style_flex_flow="column" style_flex_main_place="center" style_pad_row="2">
			<lv_label name="title_label" width="100%" long_mode="wrap" text="$title" style_text_font="font_label" />
			<lv_label name="detail_label" width="100%" long_mode="wrap" text="$detail" style_text_font="font_caption" style_text_color="#color_text_2" />
		</box>
		<lv_switch name="toggle" ext_click_area="12">
			<style name="style_switch_icon" />
			<style name="style_switch_icon_indicator" selector="indicator" />
			<style name="style_switch_icon_on" selector="indicator|checked" />
			<style name="style_switch_icon_knob" selector="knob" />
			<style name="style_switch_icon_knob_on" selector="knob|checked" />
		</lv_switch>
	</view>
</component>
