<component>
	<!-- Code entry, iPhone style: a dot per digit in the hint's place (codes are 4-10 digits, so
	     the length is open), the action as the title, and the check key to submit. Arming shows the options
	     (instant, silent exit, bypass open zones); fire and CO show Silence. The action's icon
	     (the one on the tile or card it stands for) sits left of the title and hint. Over the screen
	     (modal_pad) a line of plain words under the title also says what the action is, so it
	     can't be taken for arming (UI-025). -->
	<api>
		<prop name="top_grow" type="int" default="1" help="1: the header's area takes the height the keys leave; 0 for a pad sized by its content" />
		<prop name="words_max" type="int" default="300" help="Widest the title and hint may be before they wrap (px): the card's inner width less the disk and gap (the X is in the corner, above them)" />
	</api>

	<styles>
		<style name="style_pad" bg_color="#color_surface" bg_opa="100%" radius="#radius_xl" border_width="1" border_color="#color_line" pad_all="#space_xl" pad_top="#space_md" layout="flex" flex_flow="column" flex_main_place="center" flex_cross_place="center" flex_track_place="center" pad_row="#space_md" />
		<style name="style_pad_icon" width="64" height="64" radius="#radius_full" bg_opa="22%" />
		<style name="style_pad_hint_under_dots" text_opa="0" />
		<style name="style_pad_words_alone" flex_cross_place="center" text_align="center" />
		<style name="style_pad_dot" width="14" height="14" radius="#radius_full" bg_color="#color_text" bg_opa="100%" />
		<style name="style_pad_close" width="36" height="36" radius="#radius_full" bg_color="#color_raised" bg_opa="100%" text_color="#color_text_2" />
		<style name="style_pad_close_pressed" bg_color="#color_pressed" />
		<style name="style_pad_keys" layout="flex" flex_flow="row_wrap" flex_main_place="center" pad_row="8" pad_column="16" />
		<style name="style_pad_enter" text_color="#color_on_tone" />
		<style name="style_pad_silence" height="44" radius="#radius_full" bg_color="#color_red" bg_opa="18%" border_width="1" border_color="#color_red" pad_left="#space_xl" pad_right="#space_xl" layout="flex" flex_flow="row" flex_cross_place="center" flex_track_place="center" pad_column="#space_sm" text_font="font_label" text_color="#color_text" />
		<style name="style_pad_silence_pressed" bg_opa="40%" />
	</styles>

	<view extends="box">
		<style name="style_pad" />

		<!-- The X sits in the card's top-right corner (10 px from both edges), like a dialog's close button, outside the
		     layout: the header below gets the card's whole width to centre in. -->
		<box name="pad_close" align="top_right" x="14" y="-2" floating="true" clickable="true" ext_click_area="16">
			<style name="style_pad_close" />
			<style name="style_pad_close_pressed" selector="pressed" />
			<bind_flag_if_eq subject="subject_pad_close_on" flag="hidden" ref_value="0" />
			<event_cb callback="ui_on_pad_close" trigger="clicked" />
			<lv_label align="center" text="&#xE1B2;" style_text_font="icons_20" />
		</box>

		<!-- The top of the card: the header (and, over the screen, the note) centred between the
		     card's top edge and the controls below it (options, Silence, keys). The card's top
		     padding is 12 and this area adds 12 above and below, so the space over the header
		     equals the space under it (12 + 12 + the card's 12 row gap = 12 + 12 + 12 on a pad
		     sized by its content, which passes top_grow="0"). -->
		<box name="pad_top" width="100%" height="content" flex_grow="$top_grow" style_pad_top="#space_md" style_pad_bottom="#space_md" style_layout="flex" style_flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="#space_md">
			<!-- The header is a media object, as on the screen saver's state card: the action's icon
			     on a tinted disk spans both lines on the left, the title (in the action's colour)
			     over the hint on its right, left-aligned and centred on the disk, and the pair
			     centred in the card. While digits are typed, the dots take the hint's line (as on a
			     phone's passcode screen): the hint turns transparent but keeps its width and the dots
			     float over its line, so the header doesn't shift at the first digit; an error puts
			     the words back. Hints are written to fit
			     one line at words_max. A pad without an icon centres its words. -->
			<box name="pad_header" width="100%" height="content" style_min_height="64" style_layout="flex" style_flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
				<box name="pad_lead" width="content" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_lg">
					<box name="pad_icon">
						<style name="style_pad_icon" />
						<bind_style_prop prop="bg_color" subject="subject_pad_color" />
						<bind_flag_if_eq subject="subject_pad_glyph_on" flag="hidden" ref_value="0" />
						<lv_label align="center" bind_text="subject_pad_glyph" style_text_font="icons_28">
							<bind_style_prop prop="text_color" subject="subject_pad_color" />
						</lv_label>
					</box>
					<box name="pad_words" width="content" height="content" style_layout="flex" style_flex_flow="column" style_flex_cross_place="start" style_flex_track_place="start" style_pad_row="2">
						<bind_style name="style_pad_words_alone" subject="subject_pad_glyph_on" ref_value="0" />
						<lv_label name="pad_title" long_mode="wrap" bind_text="subject_pad_title" style_max_width="$words_max" style_text_font="font_title">
							<bind_style_prop prop="text_color" subject="subject_pad_color" />
						</lv_label>
						<lv_label name="pad_hint" long_mode="wrap" bind_text="subject_pad_hint" style_max_width="$words_max">
							<style name="style_text_2" />
							<bind_style name="style_text_error" subject="subject_pad_error" ref_value="1" />
							<bind_style name="style_pad_hint_under_dots" subject="subject_pad_dots_on" ref_value="1" />
						</lv_label>
						<box name="pad_dots" align="bottom_left" floating="true" width="content" height="24" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="12">
							<bind_flag_if_eq subject="subject_pad_dots_on" flag="hidden" ref_value="0" />
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="1" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="2" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="3" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="4" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="5" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="6" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="7" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="8" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="9" />
							</box>
							<box>
								<style name="style_pad_dot" />
								<bind_flag_if_lt subject="subject_pad_digits" flag="hidden" ref_value="10" />
							</box>
						</box>
					</box>
				</box>
			</box>

			<lv_label name="pad_note" width="100%" long_mode="wrap" bind_text="subject_pad_note" style_text_align="center" style_text_font="font_caption" style_text_color="#color_text_3">
				<bind_flag_if_eq subject="subject_pad_note_on" flag="hidden" ref_value="0" />
			</lv_label>
		</box>

		<!-- The arming options wrap to a second row when they don't fit one (three chips: "Bypass
		     open" shows when the house isn't ready); the keys are sized so both rows fit the card.
		     Where a language's words put each chip on a row of its own, the keys get shorter
		     (pad_key's user_2 state, set by ui_app.c pad_fit) so the header still fits above. -->
		<box name="pad_options" width="100%" height="content" style_layout="flex" style_flex_flow="row_wrap" style_flex_main_place="center" style_flex_track_place="center" style_pad_column="#space_sm" style_pad_row="#space_sm">
			<bind_flag_if_eq subject="subject_pad_options" flag="hidden" ref_value="0" />
			<!-- tr-context: arming option, no entry time -->
			<chip text="No entry delay" subject="subject_opt_instant" />
			<chip text="Silent exit" subject="subject_opt_silent">
				<bind_flag_if_eq subject="subject_opt_silent_avail" flag="hidden" ref_value="0" />
			</chip>
			<chip text="Bypass open" subject="subject_opt_bypass">
				<bind_flag_if_eq subject="subject_opt_bypass_avail" flag="hidden" ref_value="0" />
			</chip>
		</box>

		<box name="pad_silence" width="content" clickable="true">
			<style name="style_pad_silence" />
			<style name="style_pad_silence_pressed" selector="pressed" />
			<bind_flag_if_eq subject="subject_pad_silence" flag="hidden" ref_value="0" />
			<event_cb callback="ui_on_silence" trigger="clicked" />
			<lv_label text="&#xE05A;" style_text_font="icons_20" style_text_color="#color_red" />
			<lv_label text="Silence" />
		</box>

		<box name="pad_keys" width="392" height="content">
			<style name="style_pad_keys" />
			<pad_key text="1">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="1" />
			</pad_key>
			<pad_key text="2">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="2" />
			</pad_key>
			<pad_key text="3">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="3" />
			</pad_key>
			<pad_key text="4">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="4" />
			</pad_key>
			<pad_key text="5">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="5" />
			</pad_key>
			<pad_key text="6">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="6" />
			</pad_key>
			<pad_key text="7">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="7" />
			</pad_key>
			<pad_key text="8">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="8" />
			</pad_key>
			<pad_key text="9">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="9" />
			</pad_key>
			<pad_key text="&#xE0AE;" font="icons_28">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="del" />
			</pad_key>
			<pad_key text="0">
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="0" />
			</pad_key>
			<pad_key name="pad_enter" text="&#xE06C;" font="icons_28">
				<style name="style_pad_enter" />
				<bind_style_prop prop="bg_color" subject="subject_pad_color" />
				<event_cb callback="ui_on_pad_key" trigger="clicked" user_data="ok" />
			</pad_key>
		</box>
	</view>
</component>
