<component>
	<!-- One day of month_calendar, created by ui_net.c (seven to a row). Checked: the chosen
	     day, filled blue; user_1: the panel's today, ringed. A cell before the 1st or after
	     the last day is empty and not clickable. -->
	<styles>
		<style name="style_cal_day" height="100%" flex_grow="1" radius="#radius_full" bg_color="#color_pressed" bg_opa="0%" text_font="font_label" text_color="#color_text" />
		<style name="style_cal_day_pressed" bg_opa="100%" />
		<style name="style_cal_day_today" border_width="2" border_color="#color_line" />
		<style name="style_cal_day_chosen" bg_color="#color_blue" bg_opa="100%" text_color="#color_on_tone" />
	</styles>

	<view extends="box" clickable="true">
		<style name="style_cal_day" />
		<style name="style_cal_day_pressed" selector="pressed" />
		<style name="style_cal_day_today" selector="user_1" />
		<style name="style_cal_day_chosen" selector="checked" />
		<lv_label name="day_label" align="center" text="" />
	</view>
</component>
