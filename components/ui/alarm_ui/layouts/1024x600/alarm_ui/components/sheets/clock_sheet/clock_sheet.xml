<component>
	<!-- Set the date and time (BL-131 finding 3), over Time and language: a calendar and the
	     hour, minute and AM/PM on one sheet, the result in words under them. Set calls
	     ui_on_sheet_done (it sets the clock as the old stepper page did), Cancel
	     ui_on_sheet_cancel (nothing changes). ui_net.c fills "clock_sheet_picker". -->
	<view extends="box" width="100%" height="100%" clickable="true">
		<style name="style_backdrop" />
		<box name="clock_card" width="880" height="content" align="center">
			<style name="style_sheet_card" />
			<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_md">
				<box flex_grow="1" height="content" style_layout="flex" style_flex_flow="column" style_pad_row="2">
					<lv_label width="100%" long_mode="dots" text="Set the date and time" style_text_font="font_title" />
					<lv_label width="100%" long_mode="wrap" text="The internet corrects it once the panel is online" style_text_color="#color_text_2" />
				</box>
				<box name="clock_cancel" width="content" clickable="true" ext_click_area="6">
					<style name="style_button" />
					<style name="style_button_pressed" selector="pressed" />
					<event_cb callback="ui_on_sheet_cancel" trigger="clicked" />
					<lv_label text="Cancel" />
				</box>
				<box name="clock_ok" width="content" clickable="true" ext_click_area="6">
					<style name="style_button" />
					<style name="style_button_primary" />
					<style name="style_button_tone_pressed" selector="pressed" />
					<event_cb callback="ui_on_sheet_done" trigger="clicked" />
					<!-- tr-context: set the clock -->
					<lv_label text="Set" />
				</box>
			</box>
			<clock_picker name="clock_sheet_picker" cal_w="#cal_w" day_h="#cal_cell_h" roll_w="#roller_w" ampm_w="#roller_ampm_w" gap="#space_xxl" roll_y="#space_lg" />
		</box>
	</view>
</component>
