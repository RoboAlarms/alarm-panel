<component>
	<!-- A device's detail sheet (BL-045, HCTL-004; mockup-next n-device-light, n-device-climate):
	     its chip, name and state in words at the top, a switch beside them for what switches, and
	     the controls its kind has in "device_body", which ui_devices.c fills. A change applies at
	     once, so it closes with an X (ui_on_sheet_cancel), with no Cancel or Done. The title and the
	     note are subject_sheet_title and subject_sheet_note: the device's whole name and state,
	     wrapped, never cut (BL-184; LVGL breaks a name without spaces between letters). The chip,
	     the switch and Close stay at the header's first row, the chip's 48 px; where a long name
	     and a tall body don't fit the card, "device_body" scrolls under the header (ui_devices.c). -->
	<styles>
		<style name="style_dsheet_switch" width="64" height="36" radius="#radius_full" bg_color="#color_pressed" bg_opa="100%" />
		<style name="style_dsheet_switch_indicator" radius="#radius_full" bg_opa="0%" />
		<style name="style_dsheet_switch_on" bg_color="#color_green" bg_opa="100%" />
		<style name="style_dsheet_switch_knob" radius="#radius_full" bg_color="#color_text" bg_opa="100%" pad_all="-4" />
	</styles>

	<view extends="box" width="100%" height="100%" clickable="true">
		<style name="style_backdrop" />
		<box name="device_card" width="600" height="content" style_max_height="#pick_max_h" align="center">
			<style name="style_sheet_card" />
			<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="start" style_flex_track_place="start" style_pad_column="#space_md">
				<icon_chip name="sheet_chip" glyph="&#xE1C2;" size="48" font="icons_28" color="#color_text_3" />
				<box flex_grow="1" height="content" style_layout="flex" style_flex_flow="column" style_pad_row="2">
					<lv_label width="100%" long_mode="wrap" bind_text="subject_sheet_title" style_text_font="font_title" />
					<lv_label name="sheet_state" width="100%" long_mode="wrap" bind_text="subject_sheet_note" style_text_color="#color_text_2" />
				</box>
				<!-- centred on the chip's 48 px: (48 - 36) / 2 -->
				<lv_switch name="sheet_switch" ext_click_area="12" style_margin_top="6">
					<style name="style_dsheet_switch" />
					<style name="style_dsheet_switch_indicator" selector="indicator" />
					<style name="style_dsheet_switch_on" selector="indicator|checked" />
					<style name="style_dsheet_switch_knob" selector="knob" />
				</lv_switch>
				<box name="device_close" width="44" height="44" clickable="true" ext_click_area="10" style_margin_top="2" style_radius="#radius_full" style_bg_color="#color_raised" style_bg_opa="100%">
					<event_cb callback="ui_on_sheet_cancel" trigger="clicked" />
					<lv_label align="center" text="&#xE1B2;" style_text_font="icons_20" style_text_color="#color_text_2" />
				</box>
			</box>
			<box name="device_body" width="100%" height="content" scrollable="true" clickable="true" user_1="true" scrollbar_mode="off" style_layout="flex" style_flex_flow="column" style_pad_row="#space_md" />
		</box>
	</view>
</component>
