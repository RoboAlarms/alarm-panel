<component>
	<!-- A sheet of rows over the screen (the kit's sheet; BL-170 "Arm the panel"): title and note,
	     Cancel and Done, and under them "form_body", which ui_forms.c (ui_form_sheet_open) empties
	     for the code to fill with rows. As tall as its rows, up to the card's maximum height; then
	     the body scrolls (ui_form_sheet_fit). Done calls ui_on_sheet_done, Cancel
	     ui_on_sheet_cancel. -->
	<view extends="box" width="100%" height="100%" clickable="true">
		<style name="style_backdrop" />
		<box name="form_card" width="760" height="content" style_max_height="584" align="center">
			<style name="style_sheet_card" />
			<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_md">
				<box flex_grow="1" height="content" style_layout="flex" style_flex_flow="column" style_pad_row="2">
					<lv_label width="100%" long_mode="dots" bind_text="subject_sheet_title" style_text_font="font_title" />
					<lv_label name="form_note" width="100%" long_mode="wrap" bind_text="subject_sheet_note" style_text_color="#color_text_2" />
				</box>
				<box name="form_cancel" width="content" clickable="true" ext_click_area="6">
					<style name="style_button" />
					<style name="style_button_pressed" selector="pressed" />
					<event_cb callback="ui_on_sheet_cancel" trigger="clicked" />
					<lv_label text="Cancel" />
				</box>
				<box name="form_ok" width="content" clickable="true" ext_click_area="6">
					<style name="style_button" />
					<style name="style_button_primary" />
					<style name="style_button_tone_pressed" selector="pressed" />
					<event_cb callback="ui_on_sheet_done" trigger="clicked" />
					<lv_label text="Done" />
				</box>
			</box>
			<box name="form_body" width="100%" height="content" scrollable="true" clickable="true" user_1="true" scrollbar_mode="off" style_layout="flex" style_flex_flow="column" style_pad_row="#space_sm" />
		</box>
	</view>
</component>
