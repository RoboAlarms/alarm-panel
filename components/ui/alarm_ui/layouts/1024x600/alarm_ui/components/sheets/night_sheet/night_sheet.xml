<component>
	<!-- Night hours (BL-131 finding 4), over Settings > Screen and sound > Night hours: when the
	     night starts and ends, each as the clock sheet's time_rollers (minutes in steps of 15), and
	     under them how long the night lasts. Done calls ui_on_sheet_done (saves both), Cancel
	     ui_on_sheet_cancel (nothing changes). ui_settings.c fills "night_start" and "night_end". -->
	<view extends="box" width="100%" height="100%" clickable="true">
		<style name="style_backdrop" />
		<box name="night_card" width="760" height="content" align="center">
			<style name="style_sheet_card" />
			<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_md">
				<box flex_grow="1" height="content" style_layout="flex" style_flex_flow="column" style_pad_row="2">
					<lv_label width="100%" long_mode="dots" text="Night hours" style_text_font="font_title" />
					<lv_label width="100%" long_mode="wrap" text="From when to when, every night" style_text_color="#color_text_2" />
				</box>
				<box name="night_cancel" width="content" clickable="true" ext_click_area="6">
					<style name="style_button" />
					<style name="style_button_pressed" selector="pressed" />
					<event_cb callback="ui_on_sheet_cancel" trigger="clicked" />
					<lv_label text="Cancel" />
				</box>
				<box name="night_ok" width="content" clickable="true" ext_click_area="6">
					<style name="style_button" />
					<style name="style_button_primary" />
					<style name="style_button_tone_pressed" selector="pressed" />
					<event_cb callback="ui_on_sheet_done" trigger="clicked" />
					<lv_label text="Done" />
				</box>
			</box>
			<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_main_place="space_around" style_pad_top="#space_sm">
				<box width="content" height="content" style_layout="flex" style_flex_flow="column" style_flex_cross_place="center" style_pad_row="#space_sm">
					<!-- tr-context: night hours -->
					<lv_label text="Starts" style_text_font="font_label" />
					<time_rollers name="night_start" roll_w="#roller_w" ampm_w="#roller_ampm_w" />
				</box>
				<box width="content" height="content" style_layout="flex" style_flex_flow="column" style_flex_cross_place="center" style_pad_row="#space_sm">
					<!-- tr-context: night hours -->
					<lv_label text="Ends" style_text_font="font_label" />
					<time_rollers name="night_end" roll_w="#roller_w" ampm_w="#roller_ampm_w" />
				</box>
			</box>
			<box width="100%" height="content" style_border_side="top" style_border_width="1" style_border_color="#color_line" style_pad_top="#space_md" style_pad_left="#space_xs" style_pad_right="#space_xs" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_lg">
				<lv_label text="Night lasts" style_text_color="#color_text_2" />
				<lv_label name="night_result" flex_grow="1" long_mode="dots" text="" style_text_font="font_label" style_text_align="right" />
			</box>
		</box>
	</view>
</component>
