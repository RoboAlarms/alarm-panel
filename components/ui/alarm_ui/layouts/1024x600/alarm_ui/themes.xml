	<!-- High contrast changes colours and edges, not the layout: every card, row and control has a
	     2 px outline inside its edge (outline_pad -2: nothing moves), what is chosen is ringed in
	     the text colour, and a switch's knob on its coloured track takes color_on_tone. -->
	<styles themes="contrast contrast_light">
		<style name="style_card" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style name="style_button" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style name="style_bar_round" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style name="style_bar_pill" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style name="style_sheet_card" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="list_row" name="style_list_row" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_switch" name="style_row_setting" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_switch" name="style_switch" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_switch_icon" name="style_row_setting_icon" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_switch_icon" name="style_switch_icon" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_stepper" name="style_row_stepper" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_stepper" name="style_step_button" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_slider" name="style_row_slider" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="row_slider" name="style_slider" outline_width="1" outline_pad="0" outline_color="#color_line" />
		<style component="event_row" name="style_event_row" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="trouble_row" name="style_trouble_row" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="zone_card" name="style_zone_card" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="zone_card" name="style_zone_bypass" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="big_value" name="style_big_value" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="chip" name="style_chip" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="arm_tile" name="style_arm_tile" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="action_tile" name="style_action_tile" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="hero" name="style_hero" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="hero" name="style_hero_alarm" outline_color="#color_red" />
		<style component="code_pad" name="style_pad" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="code_pad" name="style_pad_close" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="pad_key" name="style_pad_key" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="month_calendar" name="style_cal_round" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="text_sheet" name="style_text_card" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="text_sheet" name="style_text_field" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<style component="text_sheet" name="style_keyboard_key" outline_width="2" outline_pad="-2" outline_color="#color_line" />
		<!-- What is chosen: ringed in the text colour -->
		<style name="style_nav_active" outline_width="2" outline_pad="-2" outline_color="#color_text" />
		<style name="style_segment_active" outline_width="2" outline_pad="-2" outline_color="#color_text" />
		<style component="cal_day" name="style_cal_day_chosen" outline_width="2" outline_pad="-2" outline_color="#color_text" />
		<!-- A switch that is on: the knob in the colour of words on a tone -->
		<style component="row_switch" name="style_switch_knob_on" bg_color="#color_on_tone" />
		<style component="row_switch_icon" name="style_switch_icon_knob_on" bg_color="#color_on_tone" />
	</styles>

	<!-- The light themes: the white knob has a thin ring where the track is light -->
	<styles themes="light contrast_light">
		<style component="row_switch" name="style_switch_knob" border_width="1" border_color="#color_text_3" />
		<style component="row_switch_icon" name="style_switch_icon_knob" border_width="1" border_color="#color_text_3" />
		<style component="row_slider" name="style_slider_knob" border_width="1" border_color="#color_text_3" />
	</styles>
</themes>
