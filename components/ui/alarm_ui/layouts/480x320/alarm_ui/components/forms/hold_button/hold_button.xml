<component>
	<!-- Press and hold to confirm something that can't be undone (factory reset). The bar
	     ("fill") fills while held; ui_app.c times it like the panic buttons. -->
	<api>
		<prop name="text" type="string" default="Hold to erase everything" help="Caption" />
		<prop name="color" type="color" default="#color_red" help="Tone" />
	</api>

	<styles>
		<style name="style_hold_button" width="100%" height="56" radius="#radius_md" bg_opa="14%" border_width="1" clip_corner="true" />
		<style name="style_hold_fill" radius="0" bg_opa="0%" />
		<style name="style_hold_fill_indicator" radius="0" bg_opa="45%" />
	</styles>

	<view extends="box" clickable="true" style_bg_color="$color" style_border_color="$color">
		<style name="style_hold_button" />
		<lv_bar name="fill" width="100%" height="100%" min_value="0" max_value="100" value="0" clickable="false" style_bg_color-indicator="$color">
			<style name="style_hold_fill" />
			<style name="style_hold_fill_indicator" selector="indicator" />
		</lv_bar>
		<lv_label align="center" text="$text" style_text_font="font_label" />
	</view>
</component>
