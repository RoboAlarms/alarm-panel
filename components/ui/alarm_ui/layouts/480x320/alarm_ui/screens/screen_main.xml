<screen permanent="true">
	<!-- The 4" panel (480 x 320): a narrow navigation rail (the logo in the state's colour,
	     Home, Zones, Activity, Troubles, Panic), a status bar (Chime is a button there), six
	     views switched by subject_view, and the sheets that open over them. The screen turns
	     red while an alarm sounds. Same object names as the 7" layout wherever the UI code or
	     the PC preview looks one up (tools/check_ui_contract.py). -->
	<view extends="lv_obj" scrollable="false">
		<style name="style_screen" />
		<bind_style name="style_screen_alarm" subject="subject_alarm_active" ref_value="1" />

		<!-- Navigation rail: five 64 x 48 entries under the logo -->
		<box name="rail" width="#rail_w" height="100%" style_bg_color="#color_rail" style_bg_opa="100%" style_border_side="right" style_border_width="1" style_border_color="#color_line" style_layout="flex" style_flex_flow="column" style_flex_cross_place="center" style_flex_track_place="center" style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_row="3">
			<box name="rail_logo" width="44" height="44">
				<lv_image name="rail_brand" align="center" width="44" height="44" style_image_recolor_opa="100%">
					<bind_style_prop prop="image_recolor" subject="subject_tone_color" />
				</lv_image>
			</box>
			<nav_item name="nav_home" glyph="&#xE158;" text="Home">
				<bind_style name="style_nav_active" subject="subject_view" ref_value="0" />
				<subject_set_int_event subject="subject_view" trigger="clicked" value="0" />
			</nav_item>
			<nav_item name="nav_zones" glyph="&#xE0FF;" text="Zones">
				<bind_style name="style_nav_active" subject="subject_view" ref_value="1" />
				<subject_set_int_event subject="subject_view" trigger="clicked" value="1" />
				<badge subject="subject_open_count" color="#color_amber" />
			</nav_item>
			<nav_item name="nav_activity" glyph="&#xE1F5;" text="Activity">
				<bind_style name="style_nav_active" subject="subject_view" ref_value="2" />
				<subject_set_int_event subject="subject_view" trigger="clicked" value="2" />
			</nav_item>
			<nav_item name="nav_troubles" glyph="&#xE193;" text="Troubles">
				<bind_style name="style_nav_active" subject="subject_view" ref_value="3" />
				<subject_set_int_event subject="subject_view" trigger="clicked" value="3" />
				<badge subject="subject_trouble_count" color="#color_amber" />
			</nav_item>
			<box name="rail_fill" width="8" flex_grow="1" />
			<nav_item name="nav_panic" glyph="&#xE2EF;" text="Panic" style_text_color="#color_red">
				<bind_style name="style_nav_active" subject="subject_view" ref_value="4" />
				<subject_set_int_event subject="subject_view" trigger="clicked" value="4" />
			</nav_item>
		</box>

		<!-- Status bar. On the left the date, or a banner (installer mode, factory codes), or -
		     while the code pad has taken Home and hidden the state card - the state and the
		     seconds left, so an exit or entry time is never out of sight. -->
		<box name="bar" x="#rail_w" width="#content_w" height="#bar_h" style_pad_left="#space_lg" style_pad_right="#space_lg" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="6">
			<box name="bar_left" flex_grow="1" height="100%" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center">
				<box name="bar_quiet" flex_grow="1" height="100%" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center">
					<bind_flag_if_eq subject="subject_panel" flag="hidden" ref_value="2" />
					<lv_label name="bar_date" width="100%" long_mode="dots" bind_text="subject_date" style_text_font="font_caption" style_text_color="#color_text_2">
						<bind_flag_if_not_eq subject="subject_bar_banner" flag="hidden" ref_value="0" />
					</lv_label>
					<box name="program_banner" width="content" height="30" clickable="true" ext_click_area="4" style_bg_color="#color_blue" style_bg_opa="16%" style_radius="#radius_full" style_pad_left="#space_lg" style_pad_right="#space_lg" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_sm">
						<bind_flag_if_not_eq subject="subject_bar_banner" flag="hidden" ref_value="2" />
						<event_cb callback="ui_on_program_exit" trigger="clicked" />
						<lv_label text="&#xE1B1;" style_text_font="icons_20" style_text_color="#color_blue" />
						<lv_label text="Leave installer" style_text_font="font_caption" style_text_color="#color_blue" />
					</box>
					<box name="codes_banner" width="content" height="30" clickable="true" ext_click_area="4" style_bg_color="#color_amber" style_bg_opa="16%" style_radius="#radius_full" style_pad_left="#space_lg" style_pad_right="#space_lg" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_sm">
						<bind_flag_if_not_eq subject="subject_bar_banner" flag="hidden" ref_value="1" />
						<event_cb callback="ui_on_change_code" trigger="clicked" />
						<lv_label text="&#xE4A3;" style_text_font="icons_20" style_text_color="#color_amber" />
						<lv_label text="Change codes" style_text_font="font_caption" style_text_color="#color_amber" />
					</box>
					<!-- The walk test (docs/features/40): started elsewhere, its end warning, its summary. -->
					<box name="walk_banner" width="content" height="30" clickable="true" ext_click_area="4" style_bg_color="#color_blue" style_bg_opa="16%" style_radius="#radius_full" style_pad_left="#space_lg" style_pad_right="#space_lg" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_sm">
						<bind_flag_if_not_eq subject="subject_bar_banner" flag="hidden" ref_value="4" />
						<event_cb callback="ui_on_end_walk_test" trigger="clicked" user_data="banner" />
						<lv_label text="&#xE3B9;" style_text_font="icons_20" style_text_color="#color_blue" />
						<lv_label bind_text="subject_walk_banner" long_mode="dots" style_max_width="190" style_text_font="font_caption" style_text_color="#color_blue" />
					</box>
					<!-- Someone uses this keypad from the network (docs/features/31): steady red, never blinking. -->
					<box name="remote_banner" width="content" height="30" clickable="true" ext_click_area="4" style_bg_color="#color_red" style_bg_opa="100%" style_radius="#radius_full" style_pad_left="#space_lg" style_pad_right="#space_lg" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_sm">
						<bind_flag_if_not_eq subject="subject_bar_banner" flag="hidden" ref_value="3" />
						<event_cb callback="ui_on_remote_banner" trigger="clicked" />
						<lv_label text="&#xE0E8;" style_text_font="icons_20" style_text_color="#color_on_tone" />
						<lv_label bind_text="subject_remote_banner" long_mode="dots" style_max_width="190" style_text_font="font_caption" style_text_color="#color_on_tone" />
					</box>
				</box>
				<box name="bar_state" flex_grow="1" height="100%" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="6">
					<bind_flag_if_not_eq subject="subject_panel" flag="hidden" ref_value="2" />
					<lv_label name="bar_state_icon" bind_text="subject_hero_icon" style_text_font="icons_20">
						<bind_style_prop prop="text_color" subject="subject_tone_color" />
					</lv_label>
					<lv_label name="bar_state_text" flex_grow="1" long_mode="dots" bind_text="subject_headline" style_text_font="font_label">
						<bind_style_prop prop="text_color" subject="subject_tone_color" />
					</lv_label>
					<lv_label name="bar_state_count" bind_text="subject_countdown" bind_text-fmt="%d s" style_text_font="font_label">
						<bind_style_prop prop="text_color" subject="subject_tone_color" />
						<bind_flag_if_eq subject="subject_countdown" flag="hidden" ref_value="0" />
					</lv_label>
				</box>
			</box>
			<box name="nav_chime" width="36" height="36" clickable="true" ext_click_area="6" style_radius="#radius_full">
				<style name="style_text_2" />
				<style name="style_nav_item_pressed" selector="pressed" />
				<bind_style name="style_nav_on" subject="subject_chime" ref_value="1" />
				<bind_style name="style_disabled" subject="subject_locked" ref_value="1" />
				<event_cb callback="ui_on_chime" trigger="clicked" />
				<lv_label align="center" bind_text="subject_chime_icon" style_text_font="icons_20" />
			</box>
			<box name="bar_trouble" width="content" height="36" clickable="true" ext_click_area="6" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="4" style_text_color="#color_amber">
				<bind_flag_if_eq subject="subject_trouble_count" flag="hidden" ref_value="0" />
				<subject_set_int_event subject="subject_view" trigger="clicked" value="3" />
				<lv_label text="&#xE193;" style_text_font="icons_20" />
				<lv_label bind_text="subject_trouble_count" bind_text-fmt="%d" style_text_font="font_label" />
			</box>
			<lv_label name="bar_wifi" bind_text="subject_wifi_icon" style_text_font="icons_20">
				<style name="style_text_2" />
				<bind_style name="style_text_warn" subject="subject_wifi_ok" ref_value="0" />
			</lv_label>
			<box name="bar_battery" width="content" height="24" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_pad_column="2">
				<style name="style_text_2" />
				<bind_style name="style_text_warn" subject="subject_battery_warn" ref_value="1" />
				<bind_style name="style_text_error" subject="subject_battery_critical" ref_value="1" />
				<box width="22" height="22">
					<lv_label name="bar_battery_icon" align="center" bind_text="subject_battery_icon" style_text_font="icons_20" />
					<box name="bar_battery_strike" x="2" y="3" width="24" height="2" style_bg_color="#color_red" style_bg_opa="255" style_transform_rotation="450" style_transform_pivot_x="0" style_transform_pivot_y="0">
						<bind_flag_if_eq subject="subject_battery_critical" flag="hidden" ref_value="0" />
					</box>
				</box>
				<lv_label name="bar_battery_text" bind_text="subject_battery_text" style_text_font="font_caption" />
			</box>
			<box name="bar_clock" width="content" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="end" style_pad_column="3">
				<lv_label name="bar_time" bind_text="subject_time" style_text_font="font_title" />
				<lv_label name="bar_ampm" bind_text="subject_ampm" style_text_font="font_caption" style_text_color="#color_text_2" style_pad_bottom="2" />
			</box>
			<box name="bar_settings" width="36" height="36" clickable="true" ext_click_area="6" style_radius="#radius_full">
				<bind_style name="style_nav_active" subject="subject_view" ref_value="5" />
				<bind_style name="style_disabled" subject="subject_locked" ref_value="1" />
				<event_cb callback="ui_on_settings" trigger="clicked" />
				<lv_label align="center" text="&#xE154;" style_text_font="icons_20" style_text_color="#color_text_2" />
			</box>
		</box>

		<!-- Views: 392 x 276 inside the content area -->
		<box name="content" x="#rail_w" y="#bar_h" width="#content_w" height="#content_h" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_bottom="#space_md">

			<!-- Home: the state card and the ways to arm. The code pad takes the whole view (the
			     status bar then carries the state), beside the rail: while armed it is Home
			     itself and Panic stays one tap away. -->
			<box name="view_home" width="100%" height="100%" style_layout="flex" style_flex_flow="row" style_pad_column="#space_md">
				<bind_flag_if_not_eq subject="subject_view" flag="hidden" ref_value="0" />
				<hero name="hero" width="#pane_w" height="100%">
					<bind_flag_if_eq subject="subject_panel" flag="hidden" ref_value="2" />
				</hero>
				<box name="pane" flex_grow="1" height="100%">
					<bind_flag_if_eq subject="subject_panel" flag="hidden" ref_value="2" />
					<box name="panel_arm" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_pad_row="#space_md">
						<bind_flag_if_not_eq subject="subject_panel" flag="hidden" ref_value="0" />
						<arm_tile glyph="&#xE10E;" title="Away" subtitle="Everyone is leaving" color="#color_rose" width="100%" flex_grow="1">
							<event_cb callback="ui_on_arm" trigger="clicked" user_data="away" />
						</arm_tile>
						<arm_tile glyph="&#xE0F5;" title="Stay" subtitle="Someone is home" color="#color_blue" width="100%" flex_grow="1">
							<event_cb callback="ui_on_arm" trigger="clicked" user_data="stay" />
						</arm_tile>
						<arm_tile glyph="&#xE11E;" title="Night" subtitle="Going to bed" color="#color_violet" width="100%" flex_grow="1">
							<event_cb callback="ui_on_arm" trigger="clicked" user_data="night" />
						</arm_tile>
					</box>
					<box name="panel_disarm" width="100%" height="100%">
						<bind_flag_if_not_eq subject="subject_panel" flag="hidden" ref_value="1" />
						<action_tile name="disarm_tile" glyph="&#xE10C;" title="subject_disarm_title" subtitle="subject_disarm_note" color="#color_green" width="100%" height="100%">
							<event_cb callback="ui_on_disarm" trigger="clicked" />
						</action_tile>
					</box>
					<box name="panel_memory" width="100%" height="100%">
						<bind_flag_if_not_eq subject="subject_panel" flag="hidden" ref_value="3" />
						<action_tile name="memory_tile" glyph="&#xE224;" title="subject_disarm_title" subtitle="subject_memory_note" color="#color_amber" width="100%" height="100%">
							<event_cb callback="ui_on_clear_memory" trigger="clicked" />
						</action_tile>
					</box>
					<!-- During a walk test: how far it got and how long it runs, the list a tap away,
					     Extend and End (each asks for a code). -->
					<box name="panel_walk" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_pad_row="#space_md">
						<bind_flag_if_not_eq subject="subject_panel" flag="hidden" ref_value="4" />
						<box name="walk_from" width="100%" height="content" style_bg_color="#color_blue" style_bg_opa="16%" style_radius="#radius_md" style_pad_all="#space_sm" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_sm">
							<bind_flag_if_eq subject="subject_walk_from_on" flag="hidden" ref_value="0" />
							<lv_label text="&#xE0E8;" style_text_font="icons_20" style_text_color="#color_blue" />
							<lv_label name="walk_from_text" flex_grow="1" long_mode="wrap" bind_text="subject_walk_from" style_text_font="font_caption" style_text_color="#color_text" />
						</box>
						<box name="walk_card" width="100%" flex_grow="1" style_bg_color="#color_surface" style_bg_opa="100%" style_radius="#radius_xl" style_border_width="1" style_border_color="#color_line" style_pad_all="#space_md" style_layout="flex" style_flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="#space_sm">
							<lv_label name="walk_count" width="100%" long_mode="wrap" bind_text="subject_walk_count" style_text_font="font_title" style_text_align="center" />
							<lv_label name="walk_left" width="100%" long_mode="wrap" bind_text="subject_walk_left" style_text_font="font_caption" style_text_align="center">
								<style name="style_text_2" />
								<bind_style name="style_text_warn" subject="subject_walk_warn" ref_value="1" />
							</lv_label>
						</box>
						<row_button name="walk_zones" glyph="&#xE06F;" text="Show zones" color="#color_blue" height="40">
							<event_cb callback="ui_on_end_walk_test" trigger="clicked" user_data="zones" />
						</row_button>
						<row_button name="walk_extend" glyph="&#xE087;" text="Extend" color="#color_blue" height="40">
							<event_cb callback="ui_on_end_walk_test" trigger="clicked" user_data="extend" />
						</row_button>
						<row_button name="walk_end" glyph="&#xE06C;" text="End test" color="#color_green" height="40">
							<event_cb callback="ui_on_end_walk_test" trigger="clicked" user_data="end" />
						</row_button>
					</box>
				</box>
				<code_pad name="pad" width="100%" height="100%" words_max="112">
					<bind_flag_if_not_eq subject="subject_panel" flag="hidden" ref_value="2" />
				</code_pad>
			</box>

			<!-- Zones: one column of cards -->
			<box name="view_zones" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_pad_row="#space_md">
				<bind_flag_if_not_eq subject="subject_view" flag="hidden" ref_value="1" />
				<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_md">
					<view_header title="Zones" note="subject_zones_note" flex_grow="1" />
					<box name="zone_filters" width="content" height="content" style_bg_color="#color_surface" style_bg_opa="100%" style_radius="#radius_lg" style_pad_all="3" style_layout="flex" style_flex_flow="row" style_pad_column="2">
						<segment text="All">
							<bind_style name="style_segment_active" subject="subject_zone_filter" ref_value="0" />
							<subject_set_int_event subject="subject_zone_filter" trigger="clicked" value="0" />
						</segment>
						<segment text="Open">
							<bind_style name="style_segment_active" subject="subject_zone_filter" ref_value="1" />
							<subject_set_int_event subject="subject_zone_filter" trigger="clicked" value="1" />
						</segment>
						<segment text="Bypassed">
							<bind_style name="style_segment_active" subject="subject_zone_filter" ref_value="2" />
							<subject_set_int_event subject="subject_zone_filter" trigger="clicked" value="2" />
						</segment>
						<segment text="Trouble">
							<bind_style name="style_segment_active" subject="subject_zone_filter" ref_value="3" />
							<subject_set_int_event subject="subject_zone_filter" trigger="clicked" value="3" />
						</segment>
					</box>
				</box>
				<box name="zone_list" width="100%" flex_grow="1" scrollable="true" clickable="true" user_1="true" scrollbar_mode="off" style_layout="flex" style_flex_flow="column" style_pad_row="#space_sm">
					<bind_flag_if_eq subject="subject_zones_empty" flag="hidden" ref_value="1" />
				</box>
				<box name="zones_none" width="100%" flex_grow="1" style_layout="flex" style_flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="#space_sm">
					<bind_flag_if_eq subject="subject_zones_empty" flag="hidden" ref_value="0" />
					<icon_chip glyph="&#xE226;" size="72" font="icons_40" color="#color_green" />
					<lv_label text="No open zones" style_text_font="font_title">
						<bind_flag_if_not_eq subject="subject_zone_filter" flag="hidden" ref_value="1" />
					</lv_label>
					<lv_label text="No bypassed zones" style_text_font="font_title">
						<bind_flag_if_not_eq subject="subject_zone_filter" flag="hidden" ref_value="2" />
					</lv_label>
					<lv_label text="No zone troubles" style_text_font="font_title">
						<bind_flag_if_not_eq subject="subject_zone_filter" flag="hidden" ref_value="3" />
					</lv_label>
				</box>
			</box>

			<!-- Activity -->
			<box name="view_activity" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_pad_row="#space_md">
				<bind_flag_if_not_eq subject="subject_view" flag="hidden" ref_value="2" />
				<view_header title="Activity" note="subject_events_note" />
				<box name="event_list" width="100%" flex_grow="1" scrollable="true" clickable="true" user_1="true" scrollbar_mode="off" style_layout="flex" style_flex_flow="column" style_pad_row="#space_sm" />
			</box>

			<!-- Troubles -->
			<box name="view_troubles" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_pad_row="#space_md">
				<bind_flag_if_not_eq subject="subject_view" flag="hidden" ref_value="3" />
				<box width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_md">
					<view_header title="Troubles" note="subject_troubles_note" flex_grow="1" />
					<box name="ack_button" width="content" height="44" clickable="true" style_bg_color="#color_raised" style_bg_opa="100%" style_radius="#radius_full" style_pad_left="#space_xl" style_pad_right="#space_xl" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_sm">
						<bind_flag_if_eq subject="subject_troubles_empty" flag="hidden" ref_value="1" />
						<bind_style name="style_disabled" subject="subject_locked" ref_value="1" />
						<event_cb callback="ui_on_ack_troubles" trigger="clicked" />
						<lv_label text="&#xE06C;" style_text_font="icons_20" />
						<lv_label text="Acknowledge" style_text_font="font_label" />
					</box>
				</box>
				<box name="trouble_list" width="100%" flex_grow="1" scrollable="true" clickable="true" user_1="true" scrollbar_mode="off" style_layout="flex" style_flex_flow="column" style_pad_row="#space_sm" />
				<!-- More troubles than fit one page: which ones are on screen, and the way
				     to the rest. Active faults come first, restored ones last. -->
				<box name="trouble_pager" width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_lg">
					<bind_flag_if_eq subject="subject_troubles_pager" flag="hidden" ref_value="0" />
					<box name="troubles_back" width="56" height="44" clickable="true" ext_click_area="4" style_bg_color="#color_raised" style_bg_opa="100%" style_radius="#radius_full">
						<event_cb callback="ui_on_troubles_page" trigger="clicked" user_data="back" />
						<lv_label align="center" text="&#xE06E;" style_text_font="icons_20" />
					</box>
					<lv_label name="troubles_page_label" bind_text="subject_troubles_page" style_text_font="font_label" style_text_color="#color_text_2" />
					<box name="troubles_more" width="56" height="44" clickable="true" ext_click_area="4" style_bg_color="#color_raised" style_bg_opa="100%" style_radius="#radius_full">
						<event_cb callback="ui_on_troubles_page" trigger="clicked" user_data="more" />
						<lv_label align="center" text="&#xE06F;" style_text_font="icons_20" />
					</box>
				</box>
				<box name="troubles_none" width="100%" flex_grow="1" style_layout="flex" style_flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="#space_sm">
					<bind_flag_if_eq subject="subject_troubles_empty" flag="hidden" ref_value="0" />
					<icon_chip glyph="&#xE226;" size="72" font="icons_40" color="#color_green" />
					<lv_label text="No troubles" style_text_font="font_title" />
					<lv_label text="Power, network and sensors are all fine" style_text_font="font_caption" style_text_color="#color_text_2" />
				</box>
			</box>

			<!-- Emergency -->
			<box name="view_panic" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="#space_lg">
				<bind_flag_if_not_eq subject="subject_view" flag="hidden" ref_value="4" />
				<box width="100%" height="content" style_layout="flex" style_flex_flow="column" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="2">
					<lv_label text="Emergency" style_text_font="font_headline" />
					<!-- Say what the panel does, not what it can't promise (UI-029): holding a
					     button sets the alarm off here. Whether anything carries it further is
					     the line below, written by ui_app.c. -->
					<lv_label width="100%" long_mode="wrap" text="Hold a button for 2 seconds to set off the alarm on this panel" style_text_align="center" style_text_color="#color_text_2" />
					<lv_label name="panic_report" width="100%" long_mode="wrap" bind_text="subject_panic_report" style_text_align="center" style_text_font="font_caption" style_text_color="#color_text_3" />
				</box>
				<box width="content" height="content" style_layout="flex" style_flex_flow="row" style_pad_column="24">
					<panic_button name="panic_police" glyph="&#xE2EF;" text="Police" color="#color_red">
						<event_cb callback="ui_on_panic" trigger="all" user_data="police" />
					</panic_button>
					<panic_button name="panic_fire" glyph="&#xE0D2;" text="Fire" color="#color_orange">
						<event_cb callback="ui_on_panic" trigger="all" user_data="fire" />
					</panic_button>
					<panic_button name="panic_medical" glyph="&#xE36E;" text="Medical" color="#color_rose">
						<event_cb callback="ui_on_panic" trigger="all" user_data="medical" />
					</panic_button>
				</box>
			</box>

			<!-- Settings: the sections as a row of icon tabs above the open page (its title
			     names the section). Pages are filled from C (settings rows); code-protected
			     sections show the code pad, which then takes the whole view. -->
			<box name="view_settings" width="100%" height="100%" style_layout="flex" style_flex_flow="column" style_pad_row="6">
				<bind_flag_if_not_eq subject="subject_view" flag="hidden" ref_value="5" />
				<box name="settings_nav" width="100%" height="44" style_layout="flex" style_flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_flex_track_place="center">
					<bind_flag_if_eq subject="subject_settings_pad" flag="hidden" ref_value="1" />
					<settings_item name="set_display" glyph="&#xE178;" title="Display and sound" subtitle="Brightness and volume" color="#color_blue">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="0" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="display" />
					</settings_item>
					<settings_item name="set_users" glyph="&#xE1A4;" title="Users" subtitle="Codes and who can do what" color="#color_violet">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="1" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="users" />
					</settings_item>
					<settings_item name="set_wifi" glyph="&#xE1AE;" title="Wi-Fi" subtitle="Network and signal" color="#color_blue">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="2" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="wifi" />
					</settings_item>
					<settings_item name="set_time" glyph="&#xE304;" title="Date and time" subtitle="Time zone, 24-hour clock" color="#color_green">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="3" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="time" />
					</settings_item>
					<settings_item name="set_integrations" glyph="&#xE63C;" title="Integrations" subtitle="Smart home and notifications" color="#color_violet">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="4" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="integrations" />
					</settings_item>
					<settings_item name="set_log" glyph="&#xE45F;" title="Event log" subtitle="Everything the panel did" color="#color_green">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="5" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="log" />
					</settings_item>
					<settings_item name="set_walk" glyph="&#xE3B9;" title="Walk test" subtitle="Check that every sensor works" color="#color_blue">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="8" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="walk" />
					</settings_item>
					<settings_item name="set_installer" glyph="&#xE1B1;" title="Installer" subtitle="Zones, delays, codes, reset" color="#color_amber">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="6" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="installer" />
					</settings_item>
					<settings_item name="set_about" glyph="&#xE0F9;" title="About" subtitle="Storage and system" color="#color_rose">
						<bind_style name="style_nav_active" subject="subject_settings_section" ref_value="7" />
						<event_cb callback="ui_on_settings_section" trigger="clicked" user_data="about" />
					</settings_item>
				</box>
				<box name="settings_page" width="100%" flex_grow="1" style_layout="flex" style_flex_flow="column" style_pad_row="6">
					<box name="page_head" width="100%" height="content" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_md">
						<bind_flag_if_eq subject="subject_settings_pad" flag="hidden" ref_value="1" />
						<box name="page_back" width="40" height="40" clickable="true" ext_click_area="6" style_radius="#radius_full" style_bg_color="#color_raised" style_bg_opa="100%">
							<bind_flag_if_eq subject="subject_page_back" flag="hidden" ref_value="0" />
							<event_cb callback="ui_on_page_back" trigger="clicked" />
							<lv_label align="center" text="&#xE06E;" style_text_font="icons_20" />
						</box>
						<box flex_grow="1" height="content" style_layout="flex" style_flex_flow="column" style_pad_row="0">
							<lv_label width="100%" long_mode="dots" bind_text="subject_page_title" style_text_font="font_title" />
							<lv_label width="100%" long_mode="wrap" bind_text="subject_page_note" style_text_font="font_caption" style_text_color="#color_text_2" />
						</box>
						<lv_spinner name="page_spinner" width="28" height="28" anim_duration="1000" arc_sweep="240" style_arc_width="4" style_arc_color="#color_line" style_arc_width-indicator="4" style_arc_color-indicator="#color_blue">
							<bind_flag_if_eq subject="subject_busy" flag="hidden" ref_value="0" />
						</lv_spinner>
					</box>
					<box name="page_body" width="100%" flex_grow="1" scrollable="true" clickable="true" user_1="true" scrollbar_mode="off" style_layout="flex" style_flex_flow="column" style_pad_row="#space_sm">
						<bind_flag_if_eq subject="subject_settings_pad" flag="hidden" ref_value="1" />
					</box>
					<box name="settings_pad_area" width="100%" height="100%">
						<bind_flag_if_eq subject="subject_settings_pad" flag="hidden" ref_value="0" />
						<code_pad name="settings_pad" width="100%" height="100%" words_max="112" />
					</box>
				</box>
			</box>
		</box>

		<!-- Sheets: text entry, choices, confirmation (subject_sheet 1, 2, 3) -->
		<text_sheet name="text_sheet">
			<bind_flag_if_not_eq subject="subject_sheet" flag="hidden" ref_value="1" />
		</text_sheet>
		<pick_sheet name="pick_sheet">
			<bind_flag_if_not_eq subject="subject_sheet" flag="hidden" ref_value="2" />
		</pick_sheet>
		<confirm_dialog name="confirm_dialog">
			<bind_flag_if_not_eq subject="subject_sheet" flag="hidden" ref_value="3" />
		</confirm_dialog>

		<!-- The code pad over the screen (chime, bypass, acknowledge): stays where you are -->
		<modal_pad name="modal">
			<bind_flag_if_eq subject="subject_modal_pad" flag="hidden" ref_value="0" />
		</modal_pad>

		<!-- Toast, centred on the content area -->
		<box name="toast" width="content" height="40" align="bottom_mid" x="#toast_x" y="#toast_y" style_max_width="400" style_bg_color="#color_pressed" style_bg_opa="100%" style_radius="#radius_full" style_border_width="1" style_border_color="0x3A4658" style_pad_left="#space_xl" style_pad_right="#space_xl" style_layout="flex" style_flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center">
			<bind_flag_if_eq subject="subject_toast_visible" flag="hidden" ref_value="0" />
			<lv_label name="toast_text" height="20" long_mode="dots" bind_text="subject_toast" style_max_width="376" style_text_font="font_label" />
		</box>
	</view>
</screen>
