CONFIG_ALARM_BUILD_RELEASE=y
# CONFIG_ALARM_BUILD_DEV is not set
CONFIG_ALARM_DEV_REMOTE=y
CONFIG_ALARM_PANEL_WEB=y
# CONFIG_ALARM_SERVICE_CONSOLE is not set
# CONFIG_ALARM_CRYPTO_DIAGNOSTICS is not set
# CONFIG_HA_LINK_DIAGNOSTICS is not set
